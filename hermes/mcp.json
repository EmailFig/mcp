{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "emailfig": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.15.2",
        "https://emailfig.com/mcp",
        "--transport",
        "http-only",
        "--auth-timeout",
        "55",
        "--static-oauth-client-metadata",
        "{\"client_name\":\"Hermes Agent\"}"
      ]
    }
  }
}
